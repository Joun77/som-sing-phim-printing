# ============================================================
# Som Sing Phim (ສົມສິ່ງພິມ) — Environment Configuration Template (.env.example)
# ============================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=somsing_db
DB_PORT=5432

# Go Backend Configuration
BACKEND_PORT=8080
DATABASE_URL=postgres://postgres:change_this_to_a_secure_password@db:5432/somsing_db?sslmode=disable
JWT_SECRET=change_this_to_a_secure_random_jwt_secret_32_chars_min
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend Web Ports (Docker)
ADMIN_PORT=3000
CUSTOMER_PORT=5173

# Phase1 isolated tests: never reuse the shop DB/5432 or this production template.
# tests/run-phase1.py constructs temporary HOME/cwd/uploads and stub provider transport.
# Opt-in fixture only (docker-compose.test.yml; no .env loading):
# TEST_FIXTURE_DSN=postgres://fixture:fixture-only-not-a-shop-secret@127.0.0.1:55432/somsing_fixture_db?sslmode=disable&connect_timeout=5
# Automatic checkout stays manual_review_required; no Gateway is enabled here.
