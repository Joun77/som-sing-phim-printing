{
  "name": "customer-service",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ส้มสิ่งพิมพ์ (SOM SING PHIM) - E-Commerce Catalog & Order Tracking System frontend",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "dev:backend": "cd ../admin-system/backend && go run .",
    "dev:all": "concurrently -n backend,frontend -c green,cyan \"npm run dev:backend\" \"vite\"",
    "deploy": "npm run build && npx -y firebase-tools@latest deploy --only hosting"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.102.8",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.33.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "three": "^0.185.1",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
