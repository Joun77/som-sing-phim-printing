{
  "name": "customer-service",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ส้มสิ่งพิมพ์ (SOM SING PHIM) - E-Commerce Catalog & Order Tracking System frontend",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "dev:backend": "cd ../admin-system/backend && go run .",
    "dev:all": "concurrently -n backend,frontend -c green,cyan \"npm run dev:backend\" \"vite\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^10.0.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "^5.6.3"
  }
}
